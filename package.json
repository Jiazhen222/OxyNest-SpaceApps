{
  "name": "oxynest",
  "version": "0.1.0",
  "private": true,
  "description": "OxyNest Moon settlement game and research references",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "test:game": "node --test tests/game-handoff.test.cjs tests/kids-*.test.cjs tests/settlement.test.cjs",
    "check:game": "node game/tools/check.js && npm run test:game",
    "build": "npm run check:game && node tools/build.cjs",
    "start": "node tools/serve.cjs",
    "test:colony": "node tools/colony-browser.cjs",
    "test:browser": "node tools/browser-smoke.cjs"
  }
}
